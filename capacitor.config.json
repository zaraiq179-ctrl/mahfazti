{
  "appId": "com.mahfazti.app",
  "appName": "محفظتي",
  "webDir": "www",
  "plugins": {
    "LocalNotifications": {
      "iconColor": "#1463FF"
    },
    "CapacitorHttp": {
      "enabled": true
    },
    "BackgroundRunner": {
      "label": "com.mahfazti.prices",
      "src": "runners/background.js",
      "event": "checkPrices",
      "repeat": true,
      "interval": 30,
      "autoStart": true
    }
  },
  "android": {
    "webContentsDebuggingEnabled": false,
    "allowMixedContent": false
  }
}